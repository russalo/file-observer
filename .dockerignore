# Keep the Docker build context small: only what `pip install .[extras]` needs
# (pyproject.toml, src/, README.md, LICENSE). Everything else is excluded.
.git
.github
.venv
venv
tests
docs
scratch
examples
site
.gemini
*.pyc
__pycache__
.pytest_cache
.mypy_cache
*.egg-info
build
dist
manifests
*.log
